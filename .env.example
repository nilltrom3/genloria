# ── GENLORIA v1 · variables de entorno ─────────────────────────────
# Copia este archivo como ".env" y ajusta los valores. NUNCA subas el .env
# real a git ni lo compartas.

# Puerto local (en Render/Railway lo define la plataforma automáticamente)
PORT=3000

# Producción: "production" activa cookies seguras (requiere HTTPS)
NODE_ENV=development

# Secreto para firmar las sesiones. Genera uno largo y aleatorio, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ OBLIGATORIO cambiarlo en producción.
SESSION_SECRET=cambia-esto-por-uno-largo-y-aleatorio

# Cuenta administradora creada en el primer arranque.
# ⚠️ Cambia ADMIN_PASS después de entrar por primera vez.
ADMIN_USER=admin
ADMIN_PASS=Cambiar123!

# Código de invitación inicial para que la familia se registre.
# El admin puede crear más códigos (de un solo uso o ilimitados) desde
# el panel de administración. Cámbialo si se filtra fuera de la familia.
INVITE_CODE=FAMILIA-2026

# Límites de subida (megabytes)
MAX_PHOTO_MB=10
MAX_VIDEO_MB=100

# Rutas de datos (por defecto van dentro del proyecto)
DB_PATH=./data/genloria.db
UPLOAD_DIR=./uploads
